<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_constraint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".MainActivity">

    <!-- Beautiful Wave Animation Layers (each layer has two ImageViews for seamless tiling) -->

    <!-- Wave header (topmost) - container holding two images side-by-side (A and B) -->
    <FrameLayout
        android:id="@+id/waveHeader_container"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="0dp"
        android:paddingTop="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <ImageView
            android:id="@+id/waveHeaderA"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
        android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:contentDescription="wave header A"
            app:srcCompat="@drawable/wave_header" />

        <ImageView
            android:id="@+id/waveHeaderB"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:contentDescription="wave header B"
            app:srcCompat="@drawable/wave_header" />
    </FrameLayout>

    <!-- Wave layer 2 (middle) -->
    <FrameLayout
        android:id="@+id/waveLayer2_container"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:layout_marginTop="0dp"
        android:paddingTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/waveLayer2A"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:alpha="0.8"
            android:scaleType="fitXY"
            android:contentDescription="wave layer 2 A"
            app:srcCompat="@drawable/wave_header" />

        <ImageView
            android:id="@+id/waveLayer2B"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:alpha="0.8"
            android:scaleType="fitXY"
            android:contentDescription="wave layer 2 B"
            app:srcCompat="@drawable/wave_header" />
    </FrameLayout>

    <!-- Wave layer 3 (backmost) -->
    <FrameLayout
        android:id="@+id/waveLayer3_container"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="0dp"
        android:paddingTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/waveLayer3A"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:alpha="0.6"
            android:scaleType="fitXY"
            android:contentDescription="wave layer 3 A"
            app:srcCompat="@drawable/wave_header" />

        <ImageView
            android:id="@+id/waveLayer3B"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:alpha="0.6"
            android:scaleType="fitXY"
            android:contentDescription="wave layer 3 B"
            app:srcCompat="@drawable/wave_header" />
    </FrameLayout>

    <!-- Floating Bubbles for Extra Effect -->
    <ImageView
        android:id="@+id/bubble1"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/bubble"
        android:alpha="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="30dp"
        android:layout_marginTop="150dp" />

    <ImageView
        android:id="@+id/bubble2"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/bubble"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="180dp" />

    <ImageView
        android:id="@+id/bubble3"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/bubble"
        android:alpha="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="100dp"
        android:layout_marginTop="120dp" />

    <ImageView
        android:id="@+id/bubble4"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/bubble"
        android:alpha="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="200dp"
        android:layout_marginTop="180dp" />

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:id="@+id/appLogo"
            android:layout_width="140dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_app"
            android:elevation="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back"
            android:textColor="@android:color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/welcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to continue your journey"
            android:textColor="#E8E8E8"
            android:textSize="16sp"
            android:letterSpacing="0.03"
            android:layout_marginBottom="40dp" />

        <!-- Enhanced Card with Glass Morphism Effect -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardPreventCornerOverlap="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:id="@+id/backgroundLayer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:alpha="0.7"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/abstract_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_in"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="12dp"
                    android:elevation="4dp"
                    android:letterSpacing="0.03"
                    android:text="SIGN IN"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/gradient_purple_dark"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_login"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sign_up"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:drawablePadding="12dp"
                    android:letterSpacing="0.03"
                    android:text="CREATE ACCOUNT"
                    android:textColor="@color/gradient_purple_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_create_acc"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconTint="@null"
                    app:rippleColor="@color/purple_light_ripple"
                    app:strokeColor="@color/gradient_purple_dark"
                    app:strokeWidth="2dp" />

                <!-- Divider with OR text -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerVertical="true"
                        android:background="#F0F0F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@android:color/white"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="OR"
                        android:textColor="#999999"
                        android:textSize="14sp" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="16dp"
                        app:cornerRadius="26dp"
                        app:icon="@drawable/ic_google"
                        app:iconPadding="0dp"
                        app:iconSize="22dp"
                        app:iconTint="@null"
                        app:strokeColor="#DDDDDD"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="70dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="12dp"
                        app:cornerRadius="26dp"
                        app:icon="@drawable/ic_facebook"
                        app:iconPadding="0dp"
                        app:iconSize="22dp"
                        app:iconTint="@null"
                        app:strokeColor="#DDDDDD"
                        app:strokeWidth="1dp" />


                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2025 Learn English."
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>